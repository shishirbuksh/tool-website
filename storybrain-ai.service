[Unit]
Description=StoryBrain AI — Multi-Tool Website
After=network.target
Wants=network-online.target

[Service]
Type=simple
# SECURITY: Never run as root.
# The 'storybrainai' user is created automatically by CloudPanel.
# If needed: sudo chown -R storybrainai:storybrainai {{APP_DIR}}
User=storybrainai
Group=storybrainai
WorkingDirectory={{APP_DIR}}

# Load .env file for all secrets and config
EnvironmentFile={{APP_DIR}}/.env

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME={{APP_DIR}}
Environment=U2NET_HOME={{APP_DIR}}/.u2net

# Security hardening
# NOTE: ProtectHome=false is required because the app lives in /home/storybrainai/
# ProtectHome=true would block access to the venv and app directory entirely (203/EXEC error)
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=false
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=022
ReadWritePaths={{APP_DIR}}/var {{APP_DIR}}/.u2net /tmp
ReadOnlyPaths={{APP_DIR}}/static {{APP_DIR}}/templates {{APP_DIR}}/app

# Resource Limits (Crucial for high traffic)
LimitNOFILE=65536
LimitNPROC=2048
# Raised 2G->4G: rembg/u2net + onnx hold ~1GB per worker; 2G OOM-killed under load.
# Lower back to 2G only on <=2GB VPS with WORKERS=2 and no rembg warmup.
MemoryMax=4G
CPUQuota=200%
# TODO: enable WatchdogSec=30 with sd_notify in app (python-systemd) so systemd
# restarts hung masters instead of serving stale /readyz.

ExecStart={{APP_DIR}}/venv/bin/gunicorn app.main:app -c {{APP_DIR}}/gunicorn_conf.py
# HUP (ExecReload) only reloads workers — it does NOT re-read EnvironmentFile (.env).
# Use `systemctl restart` for code/venv/.env changes; reserve HUP for manual
# zero-downtime nudges when only request handling needs a refresh.
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStartSec=300
TimeoutStopSec=360
KillMode=mixed

Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
