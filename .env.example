# ============================================================
# StoryBrain AI — Production Configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Application
PROJECT_NAME="StoryBrain AI"
SITE_URL=https://www.storybrainai.com
# Deployed commit SHA (written automatically by deploy.sh — do not hand-edit)
APP_VERSION=dev
# Set prod on production hosts to enable strict fail-closed checks (SECRET_KEY, ALLOWED_HOSTS).
ENV=prod

# Server binding — keep 127.0.0.1 behind Caddy; firewall 8090 (ufw deny 8090).
# Caddy on the same host is the only client; never expose gunicorn directly.
HOST=127.0.0.1
PORT=8090

# Gunicorn workers (0 = auto: cores + 1)
WORKERS=0
LOG_LEVEL=info
TIMEOUT=320
GRACEFUL_TIMEOUT=110
KEEP_ALIVE=5

# Redis (optional — app falls back to in-memory cache if unavailable)
REDIS_URL=

# Security — comma-separated, no spaces
# IMPORTANT: Must include your actual domain + VPS IP, or requests will be rejected.
# Example: ALLOWED_HOSTS=storybrainai.com,*.storybrainai.com,your-vps-ip
ALLOWED_HOSTS=
CORS_ORIGINS=

# Auth secret — auto-generated by deploy.sh on first setup (appended if missing).
# Generate manually with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Caddy reverse proxy (see Caddyfile; CADDY_STATIC_ROOT must match $APP_DIR/static)
CADDY_DOMAIN=storybrainai.com
CADDY_PROXY_UPSTREAM=127.0.0.1:8090
CADDY_STATIC_ROOT=/opt/storybrain-ai/static

# Trust only your reverse proxy for X-Forwarded-For (never "*" in production).
# Example: FORWARDED_ALLOW_IPS=127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1

# Local model cache for rembg (also set as U2NET_HOME in storybrain-ai.service)
U2NET_HOME=./.u2net
