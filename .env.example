# ============================================================
# StoryBrain AI — Production Configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Application
PROJECT_NAME="StoryBrain AI"
SITE_URL=https://www.storybrainai.com
# Deployed commit SHA (written automatically by deploy.sh — do not hand-edit)
APP_VERSION=dev
# Set prod on production hosts to enable strict fail-closed checks (SECRET_KEY, ALLOWED_HOSTS).
ENV=prod

# Server binding — keep 127.0.0.1 behind Caddy; firewall 8090 (ufw deny 8090).
# Caddy on the same host is the only client; never expose gunicorn directly.
HOST=127.0.0.1
PORT=8090

# Gunicorn workers (0 = auto: cores + 1)
WORKERS=0
LOG_LEVEL=info
TIMEOUT=320
# Keep close to TIMEOUT (300 vs 320) so graceful reloads let in-flight ML finish;
# a small value (e.g. 110) kills long tasks early and causes 502s on deploy.
GRACEFUL_TIMEOUT=300
KEEP_ALIVE=5

# Redis (optional — app falls back to in-memory cache if unavailable)
REDIS_URL=

# Security — comma-separated, no spaces
# IMPORTANT: Must include your actual domain + VPS IP, or requests will be rejected.
# Example: ALLOWED_HOSTS=storybrainai.com,*.storybrainai.com,your-vps-ip
ALLOWED_HOSTS=
CORS_ORIGINS=

# Auth secret — REQUIRED in prod (ENV=prod fail-closes if missing or `change-me`).
# Auto-generated by deploy.sh on first setup (appended if missing) — never commit
# the real value, never leave as `change-me`, min 32 random bytes.
# Generate manually with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Caddy reverse proxy (see Caddyfile; CADDY_STATIC_ROOT must be the absolute
# $APP_DIR/static from deploy.sh, e.g. /home/storybrainai/tool-website-main/static
# when APP_DIR is there. Default below matches the Caddyfile fallback and only
# works when deployed at /opt/storybrain-ai — adjust if your APP_DIR differs.)
CADDY_DOMAIN=storybrainai.com
CADDY_PROXY_UPSTREAM=127.0.0.1:8090
CADDY_STATIC_ROOT=/opt/storybrain-ai/static

# Trust only your reverse proxy for X-Forwarded-For (never "*" in production).
# Example: FORWARDED_ALLOW_IPS=127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1

# Local model cache for rembg (also set as U2NET_HOME in storybrain-ai.service)
U2NET_HOME=./.u2net

# Upload limits (bytes) — enforced by MaxBodySizeMiddleware + services
IMAGE_MAX_SIZE=10485760
PDF_MAX_SIZE=5242880

# Cache + analytics tuning (defaults match app/core/config.py)
CACHE_DEFAULT_TTL=300
TRACK_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_CLEANUP_INTERVAL=300

# Contact form mail (empty CONTACT_EMAIL = form no-ops with warning; set all to enable)
CONTACT_EMAIL=
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=

# Gunicorn: multiplier for auto worker count (cores * per-core + 1); WORKERS=0 = auto
WORKERS_PER_CORE=1
# Extra trusted proxy IPs for gunicorn forwarded_allow_ips (comma-separated)
PROXY_ALLOW_IPS=127.0.0.1
